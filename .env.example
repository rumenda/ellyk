# ---- Supabase (from `supabase status` locally, or the project's API settings) ----
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose to the browser or commit it.
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000
# "production" blocks the seed script.
APP_ENV=development

# ---- M-Pesa Daraja (C2B Paybill) ----
# sandbox | production. Sandbox enables the clearly-labelled payment simulator.
MPESA_ENV=sandbox
# Random secret (>= 24 chars) appended to the callback URLs registered with Safaricom.
MPESA_CALLBACK_TOKEN=
MPESA_SHORTCODE=
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
# Optional comma-separated source-IP allow-list for callbacks (Safaricom publishes its IPs).
MPESA_ALLOWED_IPS=

# ---- Notifications (sandbox = logged, not sent, until configured) ----
SMS_PROVIDER=sandbox            # sandbox | africastalking
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
AFRICASTALKING_SENDER_ID=
EMAIL_PROVIDER=sandbox          # sandbox | resend
RESEND_API_KEY=
EMAIL_FROM=
# Web push: generate with `npx web-push generate-vapid-keys`
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# ---- Scheduled jobs ----
# Bearer token required by /api/cron/notifications (>= 16 chars).
CRON_SECRET=
